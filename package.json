{
  "name": "connectinq-ui",
  "version": "0.5.0",
  "description": "The shared look of the ConnectinQ front-ends: design tokens, base styles, and a few Vue components.",
  "private": true,
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    "./cq.css": "./src/cq.css",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./display": "./src/display.ts",
    "./frame": "./src/frame.ts",
    "./glyphs": "./src/glyphs.ts",
    "./switcher": "./src/switcher.ts",
    "./platform": "./src/platform.ts",
    "./*.vue": "./src/*.vue",
    "./tour": "./src/tour/index.ts",
    "./tour/*.vue": "./src/tour/*.vue",
    "./help": "./src/help/index.ts",
    "./help/*.vue": "./src/help/*.vue"
  },
  "scripts": {
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.38.0",
    "vue": "^3.5.0",
    "vue-router": ">=4.0.0"
  },
  "devDependencies": {
    "@lucide/vue": "1.38.0",
    "@vitejs/plugin-vue": "6.0.10",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.14"
  }
}
